# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
# The blue/green slot builds (.next-a / .next-b) and the file recording which
# slot is currently live. See ops/README.md.
.next-*/
/.deploy-slot
out/
build/
next-env.d.ts

# python
__pycache__/
*.py[cod]
.venv/
venv/

# source exam PDFs — NOT redistributed.
# ~222 MB of UPSC previous-year papers. Fetch them yourself into pdfs/
# (see README "Data pipeline"). pdfs/_manifest.json lists what is expected.
pdfs/*
!pdfs/_manifest.json

# scraped answer-key images from third-party coaching sites — not redistributed.
# The derived keys.json / manual_keys.json ARE tracked.
answer_keys/*.jpg
answer_keys/*.jpeg
answer_keys/*.png
answer_keys/*.pdf

# OCR transcriptions of the exam papers — same content as pdfs/, in text form.
# Not redistributed, for the same reason the PDFs are not. Regenerate locally
# with scripts/ocr_and_parse.py.
scripts/ocr_text/
# Same again for the General Knowledge papers. Regenerate with scripts/gk_ocr.py.
scripts/ocr_gk_text/

# The OPERATIONAL copy of the deploy script, at the path the SSH forced command
# invokes. The canonical, reviewable copy is committed at ops/deploy.sh.
#
# This one stays untracked on purpose, and it is a correctness requirement rather
# than a preference: deploy.sh runs `git reset --hard`, and bash reads a script
# incrementally while executing it. Tracking the running copy would let a deploy
# that changes deploy.sh rewrite the file underneath the shell running it, which
# then resumes at a byte offset pointing into different code. See ops/README.md.
/deploy.sh

# logs & local artifacts
scripts/ocr_log.txt
*.log
.DS_Store
.env
.env.*
# but the template carries no secrets and should be committed
!.env.example
.vercel
.ui-design/

# typescript incremental build cache
*.tsbuildinfo

# playwright screenshots
.visual/

.vercel
.env*
