# source exam PDFs — NOT redistributed.
# ~222 MB of UPSC previous-year papers. Fetch them yourself into pdfs/
# (see README "Data pipeline"). pdfs/_manifest.json lists what is expected.
pdfs/*
!pdfs/_manifest.json

# scraped answer-key images from third-party coaching sites — not redistributed.
# The derived keys.json / manual_keys.json ARE tracked.
answer_keys/*.jpg
answer_keys/*.jpeg
answer_keys/*.png
answer_keys/*.pdf

# OCR transcriptions of the exam papers — same content as pdfs/, in text form.
# Not redistributed, for the same reason the PDFs are not. Regenerate locally
# with scripts/ocr_and_parse.py.
scripts/ocr_text/

# logs & local artifacts
scripts/ocr_log.txt
*.log
