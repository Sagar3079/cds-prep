# Potter's explanation model. Optional — with no key set, /api/explain returns a
# scripted explanation built from the answer bank and the app works normally.
#
# NEVER prefix these with NEXT_PUBLIC_. That would inline the key into the
# client bundle, and this repo is public.
SCALEMAX_API_KEY=
SCALEMAX_BASE_URL=https://api.scalemax.pro/token
SCALEMAX_MODEL=glm-5.2

# Razorpay Standard Checkout. Optional — with neither set, /pricing renders the
# plans without pay buttons and both payment endpoints answer 503.
#
# NEVER prefix these with NEXT_PUBLIC_ either. The key id is public by design,
# but the browser gets it from /api/payments/order rather than from the bundle,
# so there is no build-time copy to go stale; the secret creates orders and
# verifies payment signatures and must never leave the server.
#
# A key id starting rzp_live_ makes the site say payments are real. Anything
# else is treated as test mode and labelled as such on the pricing page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook. A DIFFERENT secret from RAZORPAY_KEY_SECRET — you choose it
# when creating the webhook in the dashboard, and it is the only thing telling a
# real event from a POST anyone can send to a public URL. Without it,
# /api/payments/webhook answers 503 and Razorpay retries until it is set.
RAZORPAY_WEBHOOK_SECRET=

# Outbound email, for the six-digit verification code. Resend's REST API.
# Without it, verification answers 503 and buying stays blocked for anyone who
# has not already verified. The domain must be verified in Resend (DKIM + SPF
# records on prepcadet.in) before anything sends.
RESEND_API_KEY=
# Optional. Defaults to "CDS Prep <support@prepcadet.in>".
MAIL_FROM=

# Upstash Redis. The store behind accounts, sessions, verification codes,
# entitlements, the leaderboard AND the rate limiter — everything on the server
# side that outlives a request.
#
# Not optional in practice, despite every caller being written to fail open.
# Unset, the app still builds and serves: tests run, scores save locally, and the
# site looks fine. What silently stops is anything with state. Accounts answer
# 503, /api/payments/order now refuses rather than charging for a plan it could
# not grant (see that file), and — the one with no visible symptom at all —
# EVERY rate limit turns off, because `ratelimit.ts` reads these same two
# variables and quietly allows everything when they are missing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Android app, for the Digital Asset Links that let the Trusted Web Activity
# drop the browser chrome. Read by /api/assetlinks.
#
# Both optional: unset, that route serves an empty array and the app falls back
# to a Custom Tab with a visible URL bar. That is the symptom to look for — a
# wrong fingerprint does not error anywhere, it just stops verifying.
#
# ANDROID_PACKAGE defaults to in.prepcadet.app. ANDROID_CERT_SHA256 is the
# signing certificate's SHA-256 as `keytool -list` prints it: colon-separated
# uppercase hex. Comma-separate several to keep an upload key and a Play
# app-signing key valid at once.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=

# The /admin panel. Both required, or the panel refuses every password —
# there is deliberately no default and no development fallback, because a
# fallback password is a production password on the day someone forgets to
# set the real one.
#
# ADMIN_PASSWORD is compared with scrypt on every attempt, so it is the actual
# defence against guessing: the rate limiter in front of it is per-IP, fails
# open, and does not exist at all when KV is unconfigured. Generate a long
# random one and do not reuse it:
#
#   python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
#
# ADMIN_SESSION_SECRET salts that hash. Changing it invalidates nothing on its
# own — admin sessions live in Redis under adm:* — but it does change what the
# stored password hashes to, so both must change together or neither.
#
#   python3 -c "import secrets;print(secrets.token_hex(32))"
#
# NEVER prefix either with NEXT_PUBLIC_. This repo is public and that prefix
# inlines the value into the browser bundle.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
