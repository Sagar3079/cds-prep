# Build outputs — regenerated by Gradle every build, never worth diffing or reviewing.
*.apk
*.aab
*.ap_
*.dex
build/
app/build/
.gradle/

# Per-machine SDK path; every dev/CI box has a different one, so this must never be committed.
local.properties

# Signing material — the whole point of build.gradle's env-var-based signingConfig is that
# these never touch the repo. If one of these shows up in `git status`, stop and check why.
*.jks
*.keystore
keystore.properties

# IDE/editor state, not project config.
.idea/
*.iml
.DS_Store

# Gradle wrapper's own working dirs (distributions are cached in ~/.gradle, not here).
gradle-app.setting
.gradletasknamecache
