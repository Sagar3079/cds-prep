# typescript-eslint has no TS 7 support yet (typescript-eslint#10940), so its
# peer range and this repo's `typescript` 7.x dependency cannot both be
# satisfied. Without this, a clean `npm install` — which is exactly what CI and
# Vercel run — exits 1 on ERESOLVE and no deploy can succeed.
#
# Scoped to a lint-only conflict: `tsc` and `next build` use the real TS 7 and
# are unaffected. Revisit when typescript-eslint ships TS 7 support.
legacy-peer-deps=true
